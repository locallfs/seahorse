{
  "expo": {
    "name": "ReefNerds",
    "slug": "reefnerds",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ReefNerds.png",
    "scheme": "reefnerds",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.woodysseahorse.reefnerds",
      "infoPlist": {
        "NSCameraUsageDescription": "ReefNerds uses the camera to take product photos.",
        "NSPhotoLibraryUsageDescription": "ReefNerds uses your photo library to attach product images."
      }
    },
    "android": {
      "package": "com.woodysseahorse.reefnerds",
      "adaptiveIcon": {
        "backgroundColor": "#0b1220",
        "foregroundImage": "./assets/images/ReefNerds.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ReefNerds.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ReefNerds.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0b1220",
          "dark": {
            "backgroundColor": "#0b1220"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ReefNerds uses your photo library to attach product images.",
          "cameraPermission": "ReefNerds uses the camera to take product photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2294b040-a57b-4817-b5ad-172b76b6f354"
      }
    },
    "owner": "pwnership"
  }
}
