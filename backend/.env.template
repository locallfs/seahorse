# ─── Database ─────────────────────────────────────────────────────────────────
# Get this from Railway after deploying PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ─── Redis (optional but recommended for production) ──────────────────────────
# Get this from Railway after deploying Redis
REDIS_URL=redis://HOST:PORT

# ─── Medusa Server ────────────────────────────────────────────────────────────
# The public URL of your deployed Medusa backend on Railway
MEDUSA_BACKEND_URL=https://your-backend.up.railway.app

# Generate two random strings (50+ characters each) for security
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_RANDOM_STRING
COOKIE_SECRET=CHANGE_ME_RANDOM_STRING

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Your Next.js storefront URL on Vercel
STORE_CORS=https://seahorseaquariumsupply.com,http://localhost:3000
ADMIN_CORS=https://admin.seahorseaquariumsupply.com,http://localhost:7001
AUTH_CORS=https://seahorseaquariumsupply.com,https://admin.seahorseaquariumsupply.com,http://localhost:3000,http://localhost:7001

# ─── Stripe ───────────────────────────────────────────────────────────────────
# From Stripe dashboard → Developers → API keys
# Use sk_test_... keys for testing, sk_live_... for production
STRIPE_API_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# ─── PayPal ───────────────────────────────────────────────────────────────────
# From PayPal Developer Dashboard → My Apps → your app
# Use sandbox credentials for testing, live credentials for production
PAYPAL_CLIENT_ID=REPLACE_WITH_YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=REPLACE_WITH_YOUR_PAYPAL_CLIENT_SECRET
